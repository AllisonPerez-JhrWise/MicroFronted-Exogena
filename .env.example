# Ruta bajo la que se monta este microfrontend (Multi-Zones). Debe coincidir con el rewrite del host.
NEXT_PUBLIC_BASE_PATH=/exogena

# URL base del microservicio de clientes (back_exogena). El navegador la llama directamente,
# por lo que el microservicio debe permitir CORS para el origen de este frontend.
# Documentación: http://localhost:8000/docs · Esquema: http://localhost:8000/openapi.json
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# URL base de la API del RUT (lee y valida el PDF del RUT). También requiere CORS.
NEXT_PUBLIC_RUT_API_BASE_URL=http://localhost:8081/api

# false = no llama a la API del RUT y usa datos de ejemplo (solo mientras la API no exista).
NEXT_PUBLIC_RUT_VALIDACION=true

# Tiempo máximo por petición al microservicio (ms).
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Organización (firma) activa, uuid. Se envía como X-Organization-Id en todas las peticiones.
NEXT_PUBLIC_ORGANIZATION_ID=

# SOLO desarrollo local: access token de Cognito (no el id token) mientras el host no entregue
# la sesión. Vence: hay que renovarlo. Nunca poner un token en .env.example ni subirlo a git.
NEXT_PUBLIC_DEV_TOKEN=
